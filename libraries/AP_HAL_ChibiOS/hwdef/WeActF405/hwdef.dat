# hwdef for the WeAct STM32F405RGT6 core board
#
# The board wiring below follows the user-supplied wiring and the public
# WeAct/INAV pinout reference. Unverified functions are intentionally not
# assigned here; see README.md.

MCU STM32F4xx STM32F405xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_WEACTF405

OSCILLATOR_HZ 8000000
STM32_VDD 330U
STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32

FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 64
STORAGE_FLASH_PAGE 2
define HAL_STORAGE_SIZE 15360

# USB
SERIAL_ORDER OTG1 USART1 USART2 UART4 USART6
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# GPS on UART4, matching the tested board definition.
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_GPS

# RC input on USART2.
PA2 USART2_TX USART2
PA3 USART2_RX USART2 ALT(1)
PA3 TIM9_CH2 TIM9 RCININT PULLDOWN LOW

# USART1 and USART6 are available for telemetry and other serial devices.
PB6 USART1_TX USART1
PB7 USART1_RX USART1
PC6 USART6_TX USART6
PC7 USART6_RX USART6 NODMA

# Onboard blue user LED.
define AP_NOTIFY_GPIO_LED_1_ENABLED 1
PB2 LED_BLUE OUTPUT LOW GPIO(0)
define AP_NOTIFY_GPIO_LED_1_PIN 0

# Tested BMP280 bus wiring.
I2C_ORDER I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# Tested MPU6500 wiring on SPI2.
PB13 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2
PB12 MPU6500_CS CS

# Onboard TF/microSD slot on the STM32F405 SDIO1 interface.
PC8  SDMMC1_D0 SDMMC1
PC9  SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2  SDMMC1_CMD SDMMC1
define HAL_OS_FATFS_IO 1

# ADC inputs are placeholders until the carrier-board wiring is verified.
define HAL_USE_ADC TRUE
define STM32_ADC_USE_ADC1 TRUE
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 1.0
define HAL_BATT_CURR_SCALE 1.0

# Motor outputs from the tested board definition.
PB8  TIM4_CH3 TIM4 PWM(1) GPIO(50)
PB5  TIM3_CH2 TIM3 PWM(2) GPIO(51)
PB4  TIM3_CH1 TIM3 PWM(3) GPIO(52)
PB3  TIM2_CH2 TIM2 PWM(4) GPIO(53)
PA10 TIM1_CH3 TIM1 PWM(5) GPIO(54)
PA9  TIM1_CH2 TIM1 PWM(6) GPIO(55)

# Buzzer pin confirmed by the public reference pinout.
PB9 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80

# SPI device and IMU
SPIDEV mpu6500 SPI2 DEVID1 MPU6500_CS MODE3 2*MHZ 8*MHZ
IMU Invensense SPI:mpu6500 ROTATION_YAW_90

# BMP280 at the standard BMP280 I2C address.
BARO BMP280 I2C:0:0x76
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_BMP280_ENABLED 1

# QMC5883L compass on the same I2C2 bus as the BMP280.
define AP_COMPASS_QMC5883L_ENABLED 1
COMPASS QMC5883L I2C:0:0x0D false ROTATION_NONE
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# Give the SDMMC and ADC resolvers priority before timer and SPI peripherals.
DMA_PRIORITY SDMMC* ADC1 TIM* SPI*

# Keep Copter within the 1 MB flash limit.
include ../include/minimize_features.inc
define AP_SCRIPTING_ENABLED 0
define HAL_PARACHUTE_ENABLED 0
define HAL_BUTTON_ENABLED 0
define AP_NOTIFY_OREOLED_ENABLED 0
